# HTTP server
PORT=3000

# SQLite database file. Relative paths resolve from the project directory.
DATABASE_PATH=".data/archive.sqlite"

# Persistent data root for optimized Gallery images and thumbnails.
DATA_DIR=".data"

# Use long, random values outside local development.
JWT_SECRET="replace-with-a-long-random-secret"

# These values seed the first administrator when the database is created.
# Changing them later does not overwrite an existing administrator.
ADMIN_EMAIL="admin@preservation.org"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Senior Archival Administrator"
